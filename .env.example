# Скопировать в .env и заполнить.
# .env перечислен в .gitignore: токен не должен попадать в репозиторий.

# Токен бота: https://discord.com/developers/applications -> Bot -> Reset Token
# Там же включается Privileged Gateway Intent: SERVER MEMBERS
# (нужен для обращения к участникам по нику).
# Права бота: Connect, Speak, Use Voice Activity.
# Scopes при выдаче ссылки-приглашения: bot + applications.commands
DISCORD_TOKEN=

# Ручка запуска игры по кодовой фразе «Башмак, дай новый сценарий».
# В ссылке токен, поэтому ей место здесь, а не в config.example.yaml: тот
# уезжает в репозиторий. Перекрывает game.url из конфига.
# BASHMAK_GAME_URL=http://31.76.226.37:5000/control/dota?token=...

# Необязательно: путь к конфигу, если он лежит не в корне проекта.
# BASHMAK_CONFIG=/opt/bashmak/config.yaml
